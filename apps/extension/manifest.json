{
  "manifest_version": 3,
  "name": "VIBE CODING WORKSPACE",
  "version": "1.0.0",
  "description": "바이브코딩 수업에 필요한 웹 도구 탭을 한곳에서 관리하고 전환합니다.",
  "permissions": ["sidePanel", "tabs", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://lovable.dev/*",
    "https://github.com/*",
    "https://cursor.com/*",
    "https://vercel.com/*",
    "https://dash.infinityfree.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "VIBE CODING WORKSPACE 열기"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html"
}
